<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>视频字幕AI总结工具</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui;
        }
        body {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
            background-color: #f5f7fa;
        }
        .box {
            background: #fff;
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 2px 10px #00000010;
            margin-bottom: 20px;
        }
        h1 {
            text-align: center;
            color: #222;
            margin-bottom: 24px;
            font-size: 22px;
        }
        input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
            margin-bottom: 16px;
        }
        button {
            width: 100%;
            padding: 13px;
            background-color: #2563eb;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
        }
        button:disabled {
            background: #94b3ee;
            cursor: not-allowed;
        }
        h3 {
            margin: 16px 0 8px;
            color: #333;
        }
        pre {
            white-space: pre-wrap;
            word-break: break-all;
            background: #f8f9fa;
            padding: 14px;
            border-radius: 8px;
            min-height: 120px;
            font-size: 14px;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="box">
        <h1>视频字幕AI总结</h1>
        <input type="text" id="videoUrl" placeholder="粘贴视频链接地址">
        <button id="submitBtn" onclick="getSummary()">开始提取并总结</button>

        <h3>原始字幕</h3>
        <pre id="subtitleBox"></pre>

        <h3>AI总结内容</h3>
        <pre id="summaryBox"></pre>
    </div>

    <script>
        // 替换成你自己部署的FastAPI后端地址
        const BACKEND_URL = "https://xxx.xxx.com/api/summarize";
        const btn = document.getElementById("submitBtn");

        async function getSummary() {
            const urlVal = document.getElementById("videoUrl").value.trim();
            if (!urlVal) {
                alert("请输入视频链接");
                return;
            }

            btn.disabled = true;
            btn.innerText = "处理中...";
            document.getElementById("subtitleBox").innerText = "";
            document.getElementById("summaryBox").innerText = "";

            try {
                const res = await fetch(`${BACKEND_URL}?video_url=${encodeURIComponent(urlVal)}`);
                const data = await res.json();

                document.getElementById("subtitleBox").innerText = data.subtitle;
                document.getElementById("summaryBox").innerText = data.summary;
            } catch (err) {
                alert("请求失败，请检查后端服务是否正常启动");
                console.error(err);
            } finally {
                btn.disabled = false;
                btn.innerText = "开始提取并总结";
            }
        }
    </script>
</body>
</html>
